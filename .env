# ═══════════════════════════════════════════════════════════════════
# AI Commerce OS — Complete Environment Reference (Phase 5)
# Copy to .env and fill in your values before running.
# NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════════════════

# ── Flask ──────────────────────────────────────────────────────────
FLASK_ENV=production
SECRET_KEY=generate-a-long-random-string-here

# ── MongoDB ────────────────────────────────────────────────────────
# Local dev: mongodb://localhost:27017/
# Atlas:     mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://arulgnanakumar_db_user:et0nDtOV93dY5kCu@cluster0.eq4zfwg.mongodb.net/?appName=Cluster0
MONGO_DB_NAME=arulgnanakumar_db_user

# ── JWT ────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=different-random-string-for-access-tokens
JWT_REFRESH_SECRET=different-random-string-for-refresh-tokens
JWT_ACCESS_EXPIRES_MINUTES=15
JWT_REFRESH_EXPIRES_DAYS=7

# ── Encryption (API keys, Razorpay secret) ─────────────────────────
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
API_KEY_ENCRYPTION_KEY=

# ── Razorpay (Test Mode) ───────────────────────────────────────────
# Get from: https://dashboard.razorpay.com > Settings > API Keys > Test Mode
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_test_secret
# Webhook secret: Razorpay Dashboard > Webhooks > Secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ── Admin ──────────────────────────────────────────────────────────
# Comma-separated emails that can access /api/admin/*
ADMIN_EMAILS=arulgnanakumar@gmail.com

# ── App URLs ───────────────────────────────────────────────────────
APP_BASE_URL=https://your-domain.com
FRONTEND_BASE_URL=https://your-domain.com

# ── AI Provider defaults ───────────────────────────────────────────
AI_TEST_TIMEOUT_SECONDS=10

# ── Embed / CORS ───────────────────────────────────────────────────
# "*" allows all origins (fine for public chat widget)
# Or restrict: https://yourstore.com,https://staging.yourstore.com
EMBED_CORS_ALLOWED_ORIGINS=*

# ── Rate limiting ──────────────────────────────────────────────────
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=60

# ── Gunicorn (production) ──────────────────────────────────────────
GUNICORN_BIND=0.0.0.0:8000
GUNICORN_WORKERS=4
GUNICORN_LOG_LEVEL=info
